# ---------------------------------------------------------------------------
# Copy to .env and fill in real values locally. NEVER commit a populated .env.
# Every value below is a placeholder.
# ---------------------------------------------------------------------------

# --- Rails ---------------------------------------------------------------
RAILS_ENV=development
RAILS_MAX_THREADS=5
PORT=3000

# --- Database (PostgreSQL) -----------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me
DATABASE_NAME=social_scheduler_development
TEST_DATABASE_NAME=social_scheduler_test
# Optional: when set, Rails merges this over the values above (used in production).
# DATABASE_URL=postgres://user:password@localhost:5432/social_scheduler_production

# --- Redis / Sidekiq -----------------------------------------------------
# Database index 1 keeps this app's queues separate from anything else using the
# same local Redis instance.
REDIS_URL=redis://localhost:6379/1
SIDEKIQ_CONCURRENCY=5

# --- Authentication (Devise + devise-jwt) --------------------------------
# Generate with: bundle exec rails secret
DEVISE_JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRATION_HOURS=24
DEVISE_MAILER_SENDER=no-reply@example.com

# --- Active Record Encryption (social account tokens at rest) ------------
# Generate a real set with: bundle exec rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=replace-with-generated-key
AR_ENCRYPTION_DETERMINISTIC_KEY=replace-with-generated-key
AR_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-generated-salt

# --- Development seed account (db/seeds.rb, development only) ------------
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=password123

# --- Frontend / CORS -----------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public base URL of this API. Used to build OAuth redirect URIs, which must
# match what is registered in each provider's developer console exactly.
# On Render this falls back to RENDER_EXTERNAL_URL if unset.
BACKEND_URL=http://localhost:3000

# --- Mail (production / Render) ------------------------------------------
# Password-reset mail is queued on Sidekiq. Without SMTP, nothing is delivered.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_AUTHENTICATION=plain
# SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# Social platform OAuth credentials.
#
# Facebook: ONE app covers unlimited Pages for all users. Do not create an app
# per user or per Page - the user's long-lived token is exchanged via
# /me/accounts to obtain a per-Page access token at connect time.
#
# Instagram and TikTok are listed for completeness; their publishers are stubs
# in this codebase and are not wired up yet.
# ---------------------------------------------------------------------------
TWITTER_CLIENT_ID=replace-me
TWITTER_CLIENT_SECRET=replace-me

LINKEDIN_CLIENT_ID=replace-me
LINKEDIN_CLIENT_SECRET=replace-me

FACEBOOK_APP_ID=replace-me
FACEBOOK_APP_SECRET=replace-me

INSTAGRAM_CLIENT_ID=replace-me
INSTAGRAM_CLIENT_SECRET=replace-me

# TikTok names these client_key/client_secret, not client_id/client_secret.
# Redirect URI to register in the TikTok console:
#   http://localhost:3000/api/v1/oauth/tiktok/callback
# video.upload posts to the creator's drafts and works before app audit;
# add video.publish only once the app has passed TikTok's review.
TIKTOK_CLIENT_KEY=replace-me
TIKTOK_CLIENT_SECRET=replace-me
TIKTOK_SCOPES=user.info.basic,video.upload
